	column QuarterYear = ```
			
			    "FY" & 
			    RIGHT([FiscalYear],2)
			    & " " & 
			    SWITCH(
			        TRUE(),
			        MONTH('Calendar'[Date]) IN {7, 8, 9}, "Q1",
			        MONTH('Calendar'[Date]) IN {10, 11, 12}, "Q2",
			        MONTH('Calendar'[Date]) IN {1, 2, 3}, "Q3",
			        MONTH('Calendar'[Date]) IN {4, 5, 6}, "Q4"
			    )
			
			```
		lineageTag: cbbbe429-dcfb-4503-a27e-3a4619d0373f
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column FiscalYear = ```
			"FY" &
			YEAR('Calendar'[Date]) + 
			IF(MONTH('Calendar'[Date]) >= 7, 1, 0)
			
			```
		lineageTag: 2b4cf32c-c350-40a8-8437-711c25d69672
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column Year = YEAR('Calendar'[Date])
