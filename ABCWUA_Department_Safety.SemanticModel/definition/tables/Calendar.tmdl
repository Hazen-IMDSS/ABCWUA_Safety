	column BeginningofQuarter =
			
			VAR ThisRowFY = 'Calendar'[FiscalYear]
			VAR ThisRowFQ = 'Calendar'[FQ]
			VAR EOQuarter = CALCULATE(FIRSTDATE('Calendar'[Date]),ALL('Calendar'),'Calendar'[FiscalYear] = ThisRowFY && 'Calendar'[FQ] = ThisRowFQ)
			RETURN EOQuarter
		formatString: Long Date
		lineageTag: d08c054a-2fda-4dfc-8158-54b30b830b3d
		summarizeBy: none

