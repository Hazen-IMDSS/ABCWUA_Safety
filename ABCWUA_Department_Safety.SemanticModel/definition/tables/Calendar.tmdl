	column FY = ```
			
			"FY" &
			RIGHT(YEAR('Calendar'[Date]) + 
			IF(MONTH('Calendar'[Date]) >= 7, 1, 0),2)
			```
		lineageTag: 7427c402-efbd-4b39-84a6-ed64de5a7bd8
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column 'FY Start Date' =
			
			VAR FYCutoffMonth = 7
			VAR FYCutoffDayofCutoffMonth = 1
			VAR DateisOnorAfterFYCutoffforCalendarYear = DATE(YEAR('Calendar'[Date]),FYCutoffMonth,FYCutoffDayofCutoffMonth) <= 'Calendar'[Date] //test if the given date is ON OR AFTER the FY cutoff for the given calendar year
			VAR CalendarYear = YEAR('Calendar'[Date])
			RETURN DATE(IF(DateisOnorAfterFYCutoffforCalendarYear,CalendarYear,CalendarYear - 1),FYCutoffMonth,FYCutoffDayofCutoffMonth)
		formatString: General Date
		lineageTag: 5193a970-8e26-494f-afee-1105c8f7cbe2
		summarizeBy: none

