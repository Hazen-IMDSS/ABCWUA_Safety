	partition InjuryData_History = m
		mode: import
		queryGroup: Gold
		source =
				let
				    Source = Table.Combine({FY22_Injuries,FY23_Injuries,FY24_Injuries, FY25_Injuries,FY26_Injuries}),
				  #"Replaced value" = Table.ReplaceValue(Source, "Sept", "Sep", Replacer.ReplaceText, {"Month"}),
				  #"Changed column type" = Table.TransformColumnTypes(#"Replaced value", {{"InjuryCount", Int64.Type}, {"FY", type text}}),
				  #"Added custom" = Table.AddColumn(#"Changed column type", "MonthNumber", each Date.Month(Date.FromText([Month] & " 1"))),
				  #"Changed column type 1" = Table.TransformColumnTypes(#"Added custom", {{"MonthNumber", Int64.Type}, {"FY", Int64.Type}}),
				  Custom = Table.AddColumn(#"Changed column type 1", "CalendarYear", each if [MonthNumber] >= 7 then ([FY] -1) else [FY]),
				  #"Changed column type 2" = Table.TransformColumnTypes(Custom, {{"CalendarYear", Int64.Type}}),
				  #"Custom 1" = Table.TransformColumnTypes(Table.AddColumn(#"Changed column type 2", "MonthStartDate", each #date(Number.From([CalendarYear]), Number.From([MonthNumber]), 1)), {{"MonthStartDate", type date}})
				
				in
				    #"Custom 1"

	annotation PBI_ResultType = Table

