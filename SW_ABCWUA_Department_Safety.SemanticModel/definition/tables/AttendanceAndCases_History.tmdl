		source =
				let
				    Source = Table.Combine({FY22_AttendanceAndCases,FY23_AttendanceAndCases,FY24_AttendanceAndCases, FY25_AttendanceAndCases,FY26_AttendanceAndCases}),
				  #"Renamed columns" = Table.RenameColumns(Source, {{"% Attendance per month", "Attendance_Percent"}, {"Recordable cases", "RecordableCases"}}),
