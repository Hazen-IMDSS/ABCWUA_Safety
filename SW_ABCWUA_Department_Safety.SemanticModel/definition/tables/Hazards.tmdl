				  #"Added custom" = Table.AddColumn(#"Renamed columns 2", "MonthNumber", each Date.Month(Date.FromText([Month] & " 1"))),
				  #"Added custom 1" = Table.AddColumn(#"Added custom", "FY", each 2026),
				  #"Inserted conditional column" = Table.AddColumn(#"Added custom 1", "CalendarYear", each if [MonthNumber] >= 7 then ([FY] -1) else [FY]),
				  #"Added custom 2" = Table.TransformColumnTypes(Table.AddColumn(#"Inserted conditional column", "MonthStartDate", each #date(Number.From([CalendarYear]), Number.From([MonthNumber]), 1)), {{"MonthStartDate", type date}}),
				  #"Changed column type 4" = Table.TransformColumnTypes(#"Added custom 2", {{"CalendarYear", Int64.Type}, {"FY", Int64.Type}, {"MonthNumber", Int64.Type}}),
				    #"Filtered Rows1" = Table.SelectRows(#"Changed column type 4", each ([Group] = "Number of High Hazards Resolved " or [Group] = "Number of L and M hazards corrected " or [Group] = "Total number of  HAZARDS  ( L,M,) reported  from Inspections Form" or [Group] = "Total number of HIGH HAZARDS  identified  from Inspections Form")),
				    #"Changed column type 3" = Table.TransformColumnTypes(#"Filtered Rows1", {{"Inspection", Int64.Type}}),
				    #"Replaced Value2" = Table.ReplaceValue(#"Changed column type 3","Total number of  HAZARDS  ( L,M,) reported  from Inspections Form","Total number of  HAZARDS  ( L,M,) identified from Inspections Form",Replacer.ReplaceText,{"Group"}),
