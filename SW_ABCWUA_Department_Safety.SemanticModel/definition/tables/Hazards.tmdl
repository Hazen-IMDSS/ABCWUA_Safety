				    #"Replaced Value1" = Table.ReplaceValue(#"Renamed columns 4","Number of L and M hazards corrected","Number of L and M Hazards Resolved",Replacer.ReplaceText,{"Group"}),
				    Custom1 = Table.AddColumn(#"Replaced Value1", "HazardRisk", each
				    if Text.Contains([Group], "L,M") or Text.Contains([Group], "L and M")
				    then "Low/Med"
				    else "High", type text),
				    #"Added Custom" = Table.AddColumn(Custom1, "HazardType", each if Text.Contains(
