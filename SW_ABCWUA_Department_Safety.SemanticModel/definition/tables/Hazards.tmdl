				then "Resolved"
				else "Identified"),
				  #"Removed columns 1" = Table.RemoveColumns(#"Added Custom", {"Group"}),
				  #"Reordered columns" = Table.ReorderColumns(#"Removed columns 1", {"MonthStartDate", "HazardRisk", "HazardType", "HazardCount", "Month", "MonthNumber", "FY", "CalendarYear"}),
