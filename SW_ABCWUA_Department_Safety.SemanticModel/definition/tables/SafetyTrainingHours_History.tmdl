	partition SafetyTrainingHours_History = m
		mode: import
		queryGroup: Gold
		source =
				let
				    Source = Table.Combine({FY22_Hours,FY23_Hours,FY24_Hours, FY25_Hours,FY26_Hours}),
				  #"Replaced value" = Table.ReplaceValue(Source, "Sept", "Sep", Replacer.ReplaceText, {"Attribute"}),
				  #"Renamed columns" = Table.RenameColumns(#"Replaced value", {{"Attribute", "Month"}}),
				  #"Added custom" = Table.AddColumn(#"Renamed columns", "MonthNumber", each Date.Month(Date.FromText([Month] & " 1"))),
				  #"Changed column type" = Table.TransformColumnTypes(#"Added custom", {{"FY", Int64.Type}, {"MonthNumber", Int64.Type}}),
				  Custom = Table.AddColumn(#"Changed column type", "CalendarYear", each if [MonthNumber] >= 7 then ([FY] - 1) else [FY]),
				  #"Custom 1" = Table.TransformColumnTypes(Table.AddColumn(#"Custom", "MonthStartDate", each #date(Number.From([CalendarYear]), Number.From([MonthNumber]), 1)), {{"MonthStartDate", type date}}),
				  #"Changed column type 1" = Table.TransformColumnTypes(#"Custom 1", {{"CalendarYear", Int64.Type}})
				
				in
				    #"Changed column type 1"

	annotation PBI_ResultType = Table

