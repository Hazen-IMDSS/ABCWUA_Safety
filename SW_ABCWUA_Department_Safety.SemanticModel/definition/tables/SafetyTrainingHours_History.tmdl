table SafetyTrainingHours_History
	lineageTag: 95be8899-841d-4a06-aee2-4707281793fa

	measure '# of Safety Hours Taught' =
			
			IF(
			    ISBLANK(SUM(SafetyTrainingHours_History[Value])),
			    0,
			    SUM(SafetyTrainingHours_History[Value])
			)
		lineageTag: 6af208fa-63e9-435f-a894-9b8567e39715

		annotation PBI_FormatHint = {"isGeneralNumber":true}

